generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  MAINTENANCE
  SUSPENDED
}

model Tenant {
  id           String            @id @default(uuid())
  slug         String            @unique
  name         String
  status       TenantStatus      @default(ACTIVE)
  customDomain String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  credential   TenantCredential?
  branding     TenantBranding?
  auditLogs     SaasAuditLog[]
  notifications Notification[]

  @@index([status])
  @@index([name])
  @@map("tenants")
}

model TenantCredential {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  moodleUrl             String
  encryptedAdminToken   String
  encryptedProctorToken String?
  timeoutBudgetMs       Int      @default(10000)
  sslVerify             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_credentials")
}

model TenantBranding {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  faviconUrl   String?
  customCss    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brandings")
}

model SaasAuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String
  actorRole  String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@map("saas_audit_logs")
}

enum NotificationType {
  EXAM_RESULT_AVAILABLE
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_GRADED
  STUDENT_ENROLLED
  STUDENT_IMPORT_COMPLETE
  STUDENT_IMPORT_FAILED
  TENANT_REGISTERED
  CREDENTIAL_FAILED
  SYSTEM_ERROR
  ANNOUNCEMENT
}

/// In-app notification (SaaS operational metadata, not Moodle data).
/// tenantId = null  → platform-scoped notification for ADMIN recipients.
/// tenantId != null → tenant-scoped notification (TENANT/TEACHER/STUDENT).
model Notification {
  id            String           @id @default(uuid())
  tenantId      String?
  recipientId   String
  recipientRole String
  type          NotificationType
  title         String
  body          String
  linkPath      String?
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientId, recipientRole, isRead])
  @@index([tenantId, recipientId, createdAt])
  @@map("notifications")
}
