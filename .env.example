# Server Configuration
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_moodle_saas?schema=public"

# Multi-tenant Configuration Template
DEFAULT_TENANT_ID=tenant_default
DEFAULT_TENANT_SLUG=demo
APP_SECRET=replace_with_a_secure_random_key_min_32_characters
# Used to encrypt the HttpOnly application-session cookie. Set one or both
# values to a unique random secret of at least 32 characters in local/hosted env.
AUTH_SESSION_SECRET=replace_with_a_unique_random_secret_min_32_characters
NEXTAUTH_SECRET=replace_with_a_unique_random_secret_min_32_characters

# Moodle Web Service Template (Server-side Only)
DEFAULT_MOODLE_URL=https://moodle.example.com
DEFAULT_MOODLE_TOKEN=replace_with_moodle_token
MOODLE_TIMEOUT_MS=10000
