# Server Configuration
PORT=3000
NODE_ENV=development

# Tenant & Security
DEFAULT_TENANT_ID=tenant_default
DEFAULT_TENANT_SLUG=demo
APP_SECRET=replace_with_a_long_random_secret_for_aes_encryption_32_bytes_minimum

# Moodle Endpoint (Per tenant or default fallback)
DEFAULT_MOODLE_URL=https://moodle.example.com
DEFAULT_MOODLE_TOKEN=your_moodle_webservice_token
MOODLE_TIMEOUT_MS=10000
