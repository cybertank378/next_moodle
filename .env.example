# Runtime
NODE_ENV=development
PORT=3000

# SaaS operational database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_moodle_saas?schema=public"
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000

# Next.js application session. Generate a unique value with at least 32 characters.
AUTH_SESSION_SECRET=replace_with_a_unique_random_secret_min_32_characters

# Encrypts each tenant's Moodle service credentials using AES-256-GCM + HKDF.
# Generate a 32-byte key represented as 64 hexadecimal characters.
TENANT_ENCRYPTION_MASTER_KEY=replace_with_64_hexadecimal_characters

# Test-only; never enable in deployed environments.
ALLOW_PRIVATE_NETWORK_FOR_TESTS=false
